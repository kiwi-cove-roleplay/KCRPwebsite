# Website accounts database - Postgres, owned by this app alone (never the
# FiveM/SFOS MySQL database portal-api sits in front of). Signing in with
# Discord creates/loads a row here regardless of whether that Discord
# account has ever connected to the FiveM server - see prisma/schema.prisma
# and lib/auth.ts. Any Postgres works (a free Neon or Vercel Postgres
# instance is the easiest path in production); for local dev, point this at
# a local Postgres and run `pnpm --filter sfos-web exec prisma migrate deploy`
# once to create the tables.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kcrp_web?schema=public

# NextAuth - generate a random string for NEXTAUTH_SECRET (e.g. `openssl
# rand -base64 32`). NEXTAUTH_URL must match wherever this app is actually
# served (http://localhost:3000 for local dev; your real domain in Vercel).
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# From a Discord application at https://discord.com/developers/applications
# (OAuth2 tab). Add a redirect URI there matching:
#   {NEXTAUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# portal-api - the only path to the FiveM/SFOS MySQL database, used purely
# to enrich a website account with game data (accountId/permissions/staff/
# characters) once per sign-in - see lib/auth.ts's events.signIn. Signing in
# to the website itself works even if this is unreachable or unset; you'll
# just show up as "not linked" until it resolves successfully.
# PORTAL_API_SECRET must match that service's PORTAL_API_SECRET exactly.
PORTAL_API_URL=http://127.0.0.1:30130
PORTAL_API_SECRET=change-me

# TEMPORARY escape hatch only - see lib/auth.ts's loadAdminBypass(). Lets a
# specific Discord id past this site's own /admin gate using a FiveM
# account id you provide, for when portal-api/the game database is
# unreachable and there's otherwise no way to bootstrap the very first
# admin (portal-api's admin endpoints still independently re-check that
# account id against permission_grants before doing anything - this can't
# grant real authority, only get you past the website's own wall). Leave
# unset once portal-api is reachable and you've confirmed
# sfos.staff.admin is granted there; don't leave this set in production
# longer than necessary. Format: "discordId:accountId,discordId2:accountId2"
ADMIN_BYPASS_ACCOUNTS=
