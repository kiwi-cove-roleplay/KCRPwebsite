// Website accounts database - Postgres, owned entirely by `web`. This is
// deliberately separate from the FiveM/SFOS MySQL database the portal API
// (FXServer itself) sits in front of (see root README's architecture
// section): signing in with Discord always creates/loads a row here,
// whether or not that Discord account has ever connected to the FiveM
// server. The portal API is only consulted afterwards, best-effort, to
// enrich the account with game-linked data - see lib/auth.ts.
//
// Account/Session/VerificationToken below are the exact shape
// @next-auth/prisma-adapter requires (https://authjs.dev/reference/adapter/prisma).
// User is that same contract plus KCRP-specific columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Discord's numeric user id, set from the OAuth profile at first sign-in
  // (see lib/auth.ts's DiscordProvider profile() override) - kept as its
  // own column so reading it never needs a join through Account.
  discordId String? @unique

  // Cached result of portal-api's /auth/resolve, refreshed once per sign-in
  // (lib/auth.ts's events.signIn), not on every session read. Stays at its
  // previous value (null/false/empty for a brand new account) whenever
  // portal-api or the game server's MySQL is unreachable, or the player has
  // never linked this Discord account to the FiveM server - either way,
  // signing in to the website itself never depends on that lookup
  // succeeding.
  gameAccountId Int?
  isStaff       Boolean  @default(false)
  permissions   String[] @default([])
  characters    Json?

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
