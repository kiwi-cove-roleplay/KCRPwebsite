[Unit]
Description=Southern Frontier OS Portal API
After=network-online.target mysqld.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO_PATH__/portal-api
ExecStart=__NODE_PATH__ dist/index.js
Restart=on-failure
RestartSec=5
User=__SERVICE_USER__
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sfos-portal-api

[Install]
WantedBy=multi-user.target
