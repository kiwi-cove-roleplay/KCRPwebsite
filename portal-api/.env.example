# Verbose console logging. Off by default, restart to change - matches
# services/discord-bot and the Lua side's sfos_debug convention.
DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sfos
DB_PASSWORD=
DB_NAME=sfos

# Shared secret checked on every request except /health. The web app must
# be configured with the exact same value (its PORTAL_API_SECRET env var).
PORTAL_API_SECRET=change-me

# Port this API listens on. Put a reverse proxy (Caddy recommended, see
# README.md) in front of it with real TLS - unlike the main SFOS repo's
# services/discord-bot /log endpoint (only ever hit by FXServer on
# localhost), this is hit by the web app running on Vercel, over the
# public internet.
PORT=30130

# Optional - push website recruitment events (application submitted, and
# staff accept/reject decisions) to the discord-bot's /log HTTP server, so
# they show up as embeds in Discord. Leave either value blank to disable.
# DISCORD_LOG_URL points at the bot's /log endpoint; DISCORD_LOG_SECRET must
# match the bot's FXSERVER_LOG_SECRET exactly. Since portal-api runs on the
# same game-server host as the bot, localhost is the norm here.
DISCORD_LOG_URL=http://127.0.0.1:30121/log
DISCORD_LOG_SECRET=change-me
